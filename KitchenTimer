// ---------- Web handlers ----------
void handleRoot() {
  server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate");
  server.sendHeader("Pragma", "no-cache");
  server.sendHeader("Expires", "0");
  server.send_P(200, "text/html", PAGE_HTML);
}

void handleSet() {
  int m = server.arg("min").toInt();
  int s = server.arg("sec").toInt();
  if (m < 0) m = 0;
  if (m > 99) m = 99;
  if (s < 0) s = 0;
  if (s > 59) s = 59;
  remainingMs = ((unsigned long)m * 60 + s) * 1000UL;
  totalMs = remainingMs;
  state = (remainingMs > 0) ? PAUSED : IDLE;
  stopBuzzer();
  Serial.print("SET: "); Serial.print(m); Serial.print("m ");
  Serial.print(s); Serial.println("s");
  server.send(200, "text/plain", "OK");
}

void handleCmd() {
  String a = server.arg("action");
  Serial.print("CMD: "); Serial.println(a);
  if (a == "start") {
    if (remainingMs > 0) {
      startMillis = millis();
      state = RUNNING;
      stopBuzzer();
    }
  } else if (a == "pause") {
    if (state == RUNNING) {
      remainingMs = currentRemaining();
      state = PAUSED;
    }
  } else if (a == "reset") {
    remainingMs = totalMs;
    state = (remainingMs > 0) ? PAUSED : IDLE;
    stopBuzzer();
  }
  server.send(200, "text/plain", "OK");
}

void handleStatus() {
  unsigned long remMs = currentRemaining();
  unsigned long remSec = (remMs + 999) / 1000;
  const char* s = "Idle";
  switch (state) {
    case IDLE: s = "Idle"; break;
    case RUNNING: s = "Running"; break;
    case PAUSED: s = "Paused"; break;
    case DONE: s = "Done!"; break;
  }
  String json = "{\"state\":\"";
  json += s;
  json += "\",\"remaining\":";
  json += remSec;
  json += "}";
  server.send(200, "application/json", json);
}

void handleBeep() {
  int freq = server.arg("freq").toInt();
  int ms   = server.arg("ms").toInt();
  if (freq < 100)  freq = 100;
  if (freq > 8000) freq = 8000;
  if (ms   < 50)   ms   = 50;
  if (ms   > 3000) ms   = 3000;

  testerActive = true;
  testerUntil  = millis() + ms;
  buzzerOn(freq);
  Serial.print("BEEP: "); Serial.print(freq);
  Serial.print(" Hz "); Serial.print(ms); Serial.println(" ms");
  server.send(200, "text/plain", "OK");
}

// ---------- Setup ----------
void setup() {
  Serial.begin(115200);
  delay(200);
  Serial.println("\n\nBooting kitchen timer...");

  pinMode(BUZZER, OUTPUT);
  buzzerOff();
  display.setBrightness(5);
  display.clear();
  display.showNumberDec(8888, true);

  WiFi.begin(WIFI_SSID, WIFI_PASS);
  Serial.print("Connecting to WiFi");
  unsigned long t0 = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t0 < 20000) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("IP: "); Serial.println(WiFi.localIP());
    int last = WiFi.localIP()[3];
    display.showNumberDec(last, false);
    delay(1500);
  } else {
    Serial.println("WiFi failed - standalone timer only");
  }

  server.on("/", handleRoot);
  server.on("/set", handleSet);
  server.on("/cmd", handleCmd);
  server.on("/status", handleStatus);
  server.on("/beep", handleBeep);
  server.onNotFound([](){
    Serial.print("404: "); Serial.println(server.uri());
    server.send(404, "text/plain", "Not found");
  });
  server.begin();
  Serial.println("Server started");
  Serial.print("Open: http://"); Serial.println(WiFi.localIP());
}

// ---------- Main loop ----------
unsigned long lastDisplay = 0;
unsigned long donePhase   = 0;

void loop() {
  server.handleClient();

  if (testerActive && millis() >= testerUntil) {
    buzzerOff();
    testerActive = false;
  }

  if (state == RUNNING && currentRemaining() == 0) {
    state = DONE;
    remainingMs = 0;
    donePhase = millis();
  }

  if (millis() - lastDisplay > 200) {
    lastDisplay = millis();
    unsigned long rem = currentRemaining();

    if (state == DONE) {
      static bool flash = false;
      flash = !flash;
      if (flash) display.showNumberDecEx(0, 0, true, 4, 0);
      else       display.clear();
    } else if (state == IDLE) {
      display.showNumberDecEx(0, 0b01000000, true, 4, 0);
    } else {
      updateDisplay(rem);
    }
  }

  if (state == DONE) {
    unsigned long since = millis() - donePhase;
    if (since < 10000) {
      beepOn = ((since / 400) % 2) == 0;
      if (beepOn && !testerActive) buzzerOn(buzzFreq);
      else if (!testerActive)      buzzerOff();
    } else {
      if (!testerActive) buzzerOff();
    }
  } else {
    if (!testerActive) buzzerOff();
  }
}
