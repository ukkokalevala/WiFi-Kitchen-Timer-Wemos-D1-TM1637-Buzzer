#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <TM1637Display.h>

// ---------- WiFi credentials ----------
const char* WIFI_SSID = "YOUR_SSID";
const char* WIFI_PASS = "YOUR_PASSWORD";

// ---------- Pins ----------
#define CLK_PIN  D1
#define DIO_PIN  D2
#define BUZZER   D5

// ---------- Buzzer config ----------
bool passiveBuzzer = true;   // false if you ever use an active buzzer
int  buzzFreq      = 2000;   // resonant frequency, tune via tester

// ---------- Objects ----------
TM1637Display display(CLK_PIN, DIO_PIN);
ESP8266WebServer server(80);

// ---------- Timer state ----------
enum TimerState { IDLE, RUNNING, PAUSED, DONE };
TimerState state = IDLE;

unsigned long totalMs     = 0;
unsigned long remainingMs = 0;
unsigned long startMillis = 0;
bool beepOn = false;

// ---------- Tester state ----------
bool testerActive = false;
unsigned long testerUntil = 0;

// ---------- Buzzer helpers ----------
void buzzerOn(int freq) {
  if (passiveBuzzer) tone(BUZZER, freq);
  else digitalWrite(BUZZER, HIGH);
}
void buzzerOff() {
  if (passiveBuzzer) noTone(BUZZER);
  else digitalWrite(BUZZER, LOW);
}
void stopBuzzer() { buzzerOff(); beepOn = false; }

// ---------- Timer helpers ----------
unsigned long currentRemaining() {
  if (state == RUNNING) {
    unsigned long elapsed = millis() - startMillis;
    if (elapsed >= remainingMs) return 0;
    return remainingMs - elapsed;
  }
  return remainingMs;
}

void updateDisplay(unsigned long msLeft) {
  unsigned long totalSec = (msLeft + 999) / 1000;
  int mm = totalSec / 60;
  int ss = totalSec % 60;
  if (mm > 99) { mm = 99; ss = 99; }
  uint8_t dots = (state == RUNNING) ? 0b01000000 : 0;
  display.showNumberDecEx(mm * 100 + ss, dots, true, 4, 0);
}

